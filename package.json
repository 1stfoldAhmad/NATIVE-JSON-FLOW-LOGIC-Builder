{
  "name": "vds-json-logic",
  "version": "0.1.0",
  "description": "JSON Logic Flow Builder \u2014 declarative JSON business-logic engine (logic, functions, classes, hooks, flows) with a thin Expo/React adapter. Core engine is independent of React, Expo and UI.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "default": "./dist/expo/index.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/node-io.d.ts",
      "default": "./dist/node-io.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"tests/*.test.ts\"",
    "demo": "tsx scripts/demo.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
